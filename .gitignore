# Certificate material — NEVER commit keys or generated certs.
certs/**
!certs/.gitignore

# Go build artifacts
*.test
*.out
bin/
dist/

# Local env
.env
.env.local

# OS
.DS_Store

# Stray local build binaries
fixture/fixture
certsvc/certsvc
observer/observer
go.work.sum

# Captured telemetry (dev-only, raw bodies — never commit)
data/
__pycache__/
*.pyc

# Local copies of telemetry pulled for registry updates
.cache/

# UI / query API
node_modules/
ui/dist/
ui/storybook-static/
api/.venv/
.playwright-mcp/
*.tsbuildinfo
.coverage
.coverage.*
htmlcov/
ui/parity/report.json
