  "tests": [
    {
      "id": "6A.11-1",
      "title": "Retry now is aria-busy in the same frame; a second click is ignored",
      "requires": [
        "Button"
      ]
    },
    {
      "id": "6A.11-2",
      "title": "Changing the window keeps old table content dimmed; never EmptyState while pending",
      "requires": [
        "SegmentedControl",
        "RegionState",
        "DataTable"
      ]
    },
    {
      "id": "6A.11-3",
      "title": "A response under 150 ms never shows a skeleton or progress bar",
      "requires": [
        "RegionState"
      ]
    },
    {
      "id": "6A.11-4",
      "title": "A 200 ms response shows the progress bar for at least 400 ms",
      "requires": [
        "RegionState",
        "ProgressBar"
      ]
    },
    {
      "id": "6A.11-5",
      "title": "Two quick window changes: only the second result renders",
      "requires": [
        "SegmentedControl",
        "RegionState"
      ]
    },
    {
      "id": "6A.11-6",
      "title": "The drawer opens with its header populated from row data before the request resolves",
      "requires": [
        "RequestDrawer"
      ]
    },
    {
      "id": "6A.11-7",
      "title": "Pagination disables with tooltips while loading; on failure aria-current returns",
      "requires": [
        "Pagination"
      ]
    },
    {
      "id": "6A.11-8",
      "title": "At 8 s Still loading with Cancel appears; Cancel restores previous content",
      "requires": [
        "RegionState",
        "SlowNotice"
      ]
    },
    {
      "id": "6A.11-9",
      "title": "Under reduced motion the drawer has no transform transition",
      "requires": [
        "RequestDrawer"
      ]
    },
    {
      "id": "6A.11-10",
      "title": "A live append while scrolled away shows NewRowsPill and doesn't move visible rows",
      "requires": [
        "NewRowsPill",
        "DataTable"
      ]
    },
    {
      "id": "12-null",
      "title": "Unknown (null) values render as a dash with a reason, never 0",
      "requires": [
        "StatTile",
        "HeaderStat"
      ]
    },
    {
      "id": "6B.11-11",
      "title": "No element in the rendered app has a title attribute",
      "requires": [
        "Tooltip"
      ]
    },
    {
      "id": "6B.11-12",
      "title": "Hovering a bin opens its tooltip after 120 ms, not before 100 ms; the next bin opens at once",
      "requires": [
        "Tooltip"
      ]
    },
    {
      "id": "6B.11-13",
      "title": "Hovering a cell opens at 400 ms; the pointer can move into the tooltip; its text is selectable",
      "requires": [
        "Tooltip"
      ]
    },
    {
      "id": "6B.11-14",
      "title": "Keyboard focus on a timeline mark shows the tooltip at once with aria-describedby; Esc closes it and keeps focus",
      "requires": [
        "Tooltip"
      ]
    },
    {
      "id": "6B.11-15",
      "title": "Clicking a bin sets the range to that bin; Enter on a focused bin does the same",
      "requires": [
        "Tooltip",
        "Timeline"
      ]
    },
    {
      "id": "6B.11-16",
      "title": "Hovering a SessionRow puts its band in hover style; hovering the band highlights the row; neither scrolls",
      "requires": [
        "SessionRow",
        "Timeline"
      ]
    },
    {
      "id": "6B.11-17",
      "title": "A null field renders — and its tooltip says why; never 0 for null",
      "requires": [
        "Tooltip"
      ]
    },
    {
      "id": "6B.11-18",
      "title": "A disabled control is focusable, ignores clicks and shows its reason",
      "requires": [
        "Tooltip",
        "Button"
      ]
    }
